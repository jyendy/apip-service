# Tabla DynamoDB core (single-table) — en AWS: apip-core (una cuenta por entorno)
APIP_TABLE_NAME=apip-core

# Opcional: auditoría append-only
# APIP_AUDIT_TABLE_NAME=apip-audit

# EventBridge (omitir en local si no publicas eventos)
# EVENT_BUS_NAME=apip-domain

# Desarrollo local: permite X-Tenant-Id sin JWT (nunca en producción)
ALLOW_DEV_TENANT_HEADER=true
